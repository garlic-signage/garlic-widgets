<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        id="com.garlic-signage.prayer-times"
        version="1.0.0"
        width="1920"
        height="1080">

    <name>Prayer Times</name>
    <description>
        Islamic prayer times (Fajr, Dhuhr, Asr, Maghrib, Isha) with the next prayer highlighted, a live countdown and the Hijri date. Data from the Aladhan API. Adapts to landscape, portrait, banner and square zones. Caches the running month for offline operation.
    </description>

    <author href="https://garlic-signage.com">Niko Sagiadinos</author>

    <icon src="icon.png"/>
    <content src="index.html"/>

    <!-- Allow the widget to reach the Aladhan API -->
    <access origin="https://api.aladhan.com" subdomains="true"/>
    <preference name="lang" ia:types="combo" ia:mandatory="true" ia:default="en" ia:label="Language">
        <ia:options value="en">English</ia:options>
        <ia:options value="ar">العربية</ia:options>
        <ia:options value="de">Deutsch</ia:options>
    </preference>


    <!-- ============ Location (required) ============ -->
    <!-- Provide latitude + longitude (canonical), OR city + country. -->
    <preference name="latitude"  ia:types="text" ia:label="Latitude" ia:tooltip="Enter a latitude. Alternative: city and country."/>
    <preference name="longitude" ia:types="text" ia:label="Longitude" ia:tooltip="Enter a longitude. Alternative: city and country."/>
    <preference name="city"      ia:types="text" ia:label="City" ia:tooltip="Enter a city. Alternative: latitude and longitude."/>
    <preference name="country"   ia:types="text" ia:label="Country" ia:tooltip="Enter a country. Alternative: latitude and longitude."/>

    <!-- ============ Calculation (important) ============ -->
    <!-- method: Aladhan calculation method id.
       2=ISNA, 3=Muslim World League, 4=Umm al-Qura, 5=Egyptian, 13=Diyanet ... -->
    <preference name="method" value="3" ia:types="integer" ia:label="Method" ia:tooltip="The Aladhan calculation method id. 2=ISNA, 3=Muslim World League, 4=Umm al-Qura, 5=Egyptian, 13=Diyanet ..." />
    <!-- school: Asr calculation. 0=Shafi (standard), 1=Hanafi -->
    <preference name="school" value="0"  ia:types="integer" ia:label="Method" ia:tooltip="The Asr calculation School. 0=Shafi (standard), 1=Hanafi" />
    <!-- timezone: IANA string, e.g. Europe/London. Leave empty to let the API decide. -->
    <preference name="timezone" ia:types="combo" ia:mandatory="false" ia:default="Europe/London" ia:label="Timezone">
        <ia:options value="">Auto (API)</ia:options>

        <!-- Middle East & Gulf -->
        <ia:options value="Asia/Riyadh">Saudi Arabia (Riyadh)</ia:options>
        <ia:options value="Asia/Mecca">Saudi Arabia (Mecca)</ia:options>
        <ia:options value="Asia/Dubai">UAE (Dubai)</ia:options>
        <ia:options value="Asia/Kuwait">Kuwait</ia:options>
        <ia:options value="Asia/Qatar">Qatar</ia:options>
        <ia:options value="Asia/Bahrain">Bahrain</ia:options>
        <ia:options value="Asia/Muscat">Oman</ia:options>
        <ia:options value="Asia/Aden">Yemen</ia:options>
        <ia:options value="Asia/Baghdad">Iraq</ia:options>
        <ia:options value="Asia/Tehran">Iran</ia:options>
        <ia:options value="Asia/Beirut">Lebanon</ia:options>
        <ia:options value="Asia/Damascus">Syria</ia:options>
        <ia:options value="Asia/Amman">Jordan</ia:options>
        <ia:options value="Asia/Jerusalem">Palestine/Israel</ia:options>

        <!-- North Africa -->
        <ia:options value="Africa/Cairo">Egypt</ia:options>
        <ia:options value="Africa/Tripoli">Libya</ia:options>
        <ia:options value="Africa/Tunis">Tunisia</ia:options>
        <ia:options value="Africa/Algiers">Algeria</ia:options>
        <ia:options value="Africa/Casablanca">Morocco</ia:options>
        <ia:options value="Africa/Khartoum">Sudan</ia:options>

        <!-- West & East Africa -->
        <ia:options value="Africa/Dakar">Senegal</ia:options>
        <ia:options value="Africa/Bamako">Mali</ia:options>
        <ia:options value="Africa/Niamey">Niger</ia:options>
        <ia:options value="Africa/Lagos">Nigeria</ia:options>
        <ia:options value="Africa/Mogadishu">Somalia</ia:options>
        <ia:options value="Africa/Nairobi">Kenya/Tanzania</ia:options>
        <ia:options value="Africa/Kampala">Uganda</ia:options>

        <!-- South & Central Asia -->
        <ia:options value="Asia/Karachi">Pakistan</ia:options>
        <ia:options value="Asia/Dhaka">Bangladesh</ia:options>
        <ia:options value="Asia/Kabul">Afghanistan</ia:options>
        <ia:options value="Asia/Tashkent">Uzbekistan</ia:options>
        <ia:options value="Asia/Almaty">Kazakhstan</ia:options>
        <ia:options value="Asia/Baku">Azerbaijan</ia:options>

        <!-- Southeast Asia -->
        <ia:options value="Asia/Jakarta">Indonesia (West)</ia:options>
        <ia:options value="Asia/Makassar">Indonesia (Central)</ia:options>
        <ia:options value="Asia/Jayapura">Indonesia (East)</ia:options>
        <ia:options value="Asia/Kuala_Lumpur">Malaysia</ia:options>
        <ia:options value="Asia/Singapore">Singapore</ia:options>
        <ia:options value="Asia/Manila">Philippines</ia:options>

        <!-- Europe (Muslim minorities) -->
        <ia:options value="Europe/London">UK</ia:options>
        <ia:options value="Europe/Paris">France</ia:options>
        <ia:options value="Europe/Berlin">Germany</ia:options>
        <ia:options value="Europe/Amsterdam">Netherlands</ia:options>
        <ia:options value="Europe/Brussels">Belgium</ia:options>
        <ia:options value="Europe/Stockholm">Sweden</ia:options>
        <ia:options value="Europe/Istanbul">Turkey</ia:options>
        <ia:options value="Europe/Moscow">Russia</ia:options>

        <!-- North America -->
        <ia:options value="America/New_York">USA Eastern</ia:options>
        <ia:options value="America/Chicago">USA Central</ia:options>
        <ia:options value="America/Denver">USA Mountain</ia:options>
        <ia:options value="America/Los_Angeles">USA Pacific</ia:options>
        <ia:options value="America/Toronto">Canada Eastern</ia:options>
        <ia:options value="America/Vancouver">Canada Pacific</ia:options>
    </preference>
    <!-- ============ Display ============ -->
    <!-- timeFormat: "24" or "12" -->
    <preference name="timeFormat" ia:types="radio" ia:default="24" ia:label="Time Format" ia:tooltip="Display time in 12 or 14 hours format.">
        <ia:options value="24" resourceKey="24" />
        <ia:options value="12" resourceKey="12" />
    </preference>
    <preference name="showSunrise" ia:types="radio" ia:default="true" ia:label="Show sunrise" ia:tooltip="Show time of the sunrise.">
        <ia:options value="true" resourceKey="true" />
        <ia:options value="false" resourceKey="false" />
    </preference>
    <preference name="showJumuah" ia:types="radio" ia:default="true" ia:label="Show jumuah" ia:tooltip="Show jumiua time.">
        <ia:options value="true" resourceKey="true" />
        <ia:options value="false" resourceKey="false" />
    </preference>
    <preference name="highlightNext" ia:types="radio" ia:default="true" ia:label="Highlight next pray" ia:tooltip="Highlight the time of the next prey.">
        <ia:options value="true" resourceKey="true" />
        <ia:options value="false" resourceKey="false" />
    </preference>
    <preference name="highlightNext" value="true"    readonly="false"/>
    <!-- accentColor: highlight colour for the next-prayer focus (hex) -->
    <preference name="accentColor" value="#0F6E56"  ia:types="color" ia:default="#0F6E56" ia:previewbg="true" readonly="false"/>
    <!-- scrollSpeed: banner marquee speed in pixels per second -->
    <preference name="scrollSpeed" value="60"  ia:types="integer" ia:label="Scroll speed" ia:tooltip="Scroll speed when widget ist dispalyd as banenr or ticker." />
    <!-- ============ Advanced (sensible defaults) ============ -->
    <!-- tune: per-prayer minute offsets, Aladhan format:
       imsak,fajr,sunrise,dhuhr,asr,maghrib,sunset,isha,midnight
       e.g. "0,2,0,2,0,1,0,2,0" -->
    <preference name="tune" ia:types="text" ia:label="Tune" ia:tooltip="tune: per-prayer minute offsets, comma seperated Aladhan format:
       imsak,fajr,sunrise,dhuhr,asr,maghrib,sunset,isha,midnight.  e.g. 0,2,0,2,0,1,0,2,0"/>
    <!-- latitudeAdjustmentMethod: for high latitudes where Fajr/Isha do not occur.
       1=Middle of the Night, 2=One Seventh, 3=Angle Based -->
    <preference name="latitudeAdjustmentMethod" value="" ia:types="text" ia:label="Tune" ia:tooltip="For high latitudes where Fajr/Isha do not occur. 1=Middle of the Night, 2=One Seventh, 3=Angle Based" />

</widget>
