<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:ia="http://schemas.iadea.com/widget"
        id="com.smil-control.countdown-flip"
        version="1.0.0">

    <name>Flip Countdown</name>
    <description>Flip-clock countdown with configurable target date, timezone, language and colors.</description>
    <author href="https://garlic-signage.com" email="niko@sagiadinos.com">Niko Sagiadinos</author>
    <content src="index.html"/>
    <icon src="icon.png"/>

    <!-- Target date and time in the given timezone. Format: YYYY-MM-DD HH:MM -->
    <preference name="target" value="2026-12-31 00:00" ia:types="text" ia:default="2026-12-31 00:00" ia:mandatory="true"
                ia:tooltip="Target date/time: YYYY-MM-DD HH:MM" readonly="false"/>

    <!-- IANA timezone name, e.g. Europe/Berlin, America/New_York. Empty = player timezone. DST is handled automatically. -->
    <preference name="timezone" value="Europe/Berlin" ia:types="text" ia:default="Europe/Berlin"
                ia:tooltip="IANA timezone, e.g. Europe/Berlin (empty = player timezone)" readonly="false"/>

    <!-- Language for the legend: de, en, es, el, fr, ru -->
    <preference name="language" value="de" ia:types="text" ia:default="de" ia:tooltip="Language: de, en, es, el, fr, ru"
                readonly="false"/>

    <preference name="bgcolor" value="#10151B" ia:types="color" ia:default="#10151B" ia:tooltip="Background color"
                ia:previewbg="true" readonly="false"/>
    <preference name="cardcolor" value="#1F2731" ia:types="color" ia:default="#1F2731" ia:tooltip="Flip card color"
                readonly="false"/>
    <preference name="digitcolor" value="#FFFFFF" ia:types="color" ia:default="#FFFFFF" ia:tooltip="Digit font color"
                readonly="false"/>
    <preference name="labelcolor" value="#8FA0B3" ia:types="color" ia:default="#8FA0B3"
                ia:tooltip="Legend color (days/hours/minutes/seconds)" readonly="false"/>

</widget>
